# =============================================================================
# Package managers
# =============================================================================
# Generated, enormous, and reformatted on every install. Prettier rewriting these
# would produce a diff nobody asked for on every single dependency bump.
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lock
bun.lockb

# =============================================================================
# Generated and vendored
# =============================================================================
# 643 media files. Formatting them is pure noise and they are not source.
/static/

# SQL migrations are generated by drizzle-kit and are already in the exact shape it
# emits. Prettier reformatting them would fight the next `drizzle-kit generate`.
/drizzle/

# =============================================================================
# Authoring workspace
# =============================================================================
# The blog pipeline: .docx sources, machine-generated markdown and reference JSON.
# Two reasons it is out of scope for the app's formatter:
#
#   1. The markdown is GENERATED from the docx by md_to_docx.ts. Reformatting it
#      means the next generation step produces a diff against the formatting, forever.
#   2. It contains fenced code fragments lifted out of application source. Prettier
#      parses those fragments as if they were standalone files and can crash on them
#      with a BABEL_PARSER_SYNTAX_ERROR that names a file nobody wrote.
#
# None of it ships: .dockerignore excludes blogs/ from the build context as well, and
# the content reaches the site through the database, not the filesystem.
/blogs/

# =============================================================================
# CI/CD
# =============================================================================
# The pipeline formats what it checks, so a rewrite of the workflow file is a
# change to the pipeline rather than a formatting diff inside it.
/.github/
