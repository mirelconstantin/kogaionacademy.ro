node_modules
.git
.svelte-kit
build
.output
.env
.env.*
!.env.example

# Docker compiles `*` to `[^/]*`, so a bare `*.md` matches markdown at the ROOT ONLY --
# it never reached project.inlang/README.md or anything nested. `**/*.md` is the form
# that means what it looks like. Nothing here is needed by the build: there are no .svx
# files, `.md` is not in `kit.extensions`, and src/lib/content-kogaion-scraped.md is not
# imported anywhere. Verified, not assumed.
**/*.md
!README.md

# Generated by the paraglide Vite plugin in buildStart(), and gitignored for that reason.
# A clean CI checkout does not have it and the plugin creates it. Excluding it here as
# well is what makes a LOCAL `docker build` produce the same image as CI: otherwise a
# stale copy from an earlier paraglide version rides along in the builder stage.
src/lib/paraglide/

Thumbs.db
.DS_Store
vite.config.ts.timestamp-*
vite.config.js.timestamp-*
project.inlang/cache

# Authoring workspace, not application source. Nothing under src/ references any of
# it, and none of it participates in `vite build`. Removing ~14 MB from the build
# context, and more importantly removing the temptation to think a .docx under
# blogs/ has anything to do with the site.
blogs/
docs/
tools/
_crawl-report/
.vscode/
.gemini/
